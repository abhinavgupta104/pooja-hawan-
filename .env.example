# ─────────────────────────────────────────────────────────────
#  Copy to `.env` and fill in.
#  Vite exposes only VITE_* to the browser — never put secrets
#  (API keys, passwords) behind a VITE_ prefix.
# ─────────────────────────────────────────────────────────────

# ── Firebase Auth — required for the /admin leads panel ──
# From Firebase Console > Project settings > Your apps > Web app.
# These values are public by design: they identify the project but
# authorise nothing. Admin access is enforced server-side by the
# ADMIN_EMAILS list on Cloud Run.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=divyarudra.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=divyarudra
VITE_FIREBASE_APP_ID=

# ── Backend API ──
# Leave unset to use the production Cloud Run URL.
# VITE_BACKEND_URL=https://kundali-backend-408824487148.asia-south1.run.app

# ── Legacy: used only by the old server.cjs dev proxy ──
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=
